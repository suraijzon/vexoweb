# Copy to .env and fill in your values
MONGODB_URI=mongodb://127.0.0.1:27017/vexoweb
JWT_SECRET=your_jwt_secret_here
# Contact form email (Google Workspace SMTP)
# Only EMAIL_USER and EMAIL_PASS are required; host/port default to smtp.gmail.com:465
# and EMAIL_TO defaults to EMAIL_USER.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=you@yourdomain.com
EMAIL_PASS=your_google_app_password_here
EMAIL_TO=leads@yourdomain.com
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=https://www.vexoweb.lk
